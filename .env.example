# Configuration for PrRag. Copy this file to .env and fill in your values.
# An LLM provider key is required only if you run/debug the API.
#
# These are the single source of truth: the compose file interpolates the very
# same names (OpenAI__*, RAG__*, ...) that the .NET debug launch reads via
# envFile, so there is only ONE name per setting — no duplicated prefixes.

# --- LLM provider ---
# One provider serves both chat and embeddings; there is no mixed configuration.
# The section is still named OpenAI because the keys are literally true: Azure
# OpenAI is reached through the same OpenAI SDK. Only the host and the deployment
# differ.
#
# openai (default) | azure
OpenAI__Provider=openai

# Required for azure, unused for openai (which has its own default host). Must be
# an absolute https URL ending in /openai/v1 -- the OpenAI-compatible surface:
#   https://<resource>.openai.azure.com/openai/v1
OpenAI__Endpoint=

# The credential for the selected provider, read from the environment so it never
# has to be committed. On azure this is that resource's key.
OpenAI__ApiKey=

# Model names on openai; on azure these are DEPLOYMENT names on your resource, and
# are used verbatim -- they are not checked against a model list. The embedding
# deployment MUST produce 1536-dimension vectors, because the column is
# vector(1536); anything else needs a migration, on either provider.
OpenAI__EmbeddingModel=text-embedding-3-small
OpenAI__ChatModel=gpt-4o-mini

# --- RAG defaults ---
RAG__TopK=5
RAG__MinSimilarity=0.7

# --- RAG observability report ---
RAG__Report__OutputDirectory=./reports

# --- PostgreSQL ---
POSTGRES_USER=prrag
POSTGRES_PASSWORD=prrag
POSTGRES_DB=prrag
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080

# --- Data & Skills (paths inside the devcontainer) ---
Data__FilePath=/workspaces/data/purchase.json
Skills__Directory=/workspaces/data/skills

# --- Web front-end ---
WEB_PORT=5173
# Comma-separated list of origins allowed to call the API cross-origin.
CORS__AllowedOrigins=http://localhost:5173,http://localhost:8080
