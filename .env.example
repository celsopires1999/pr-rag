# Configuration for PrRag. Copy this file to .env and fill in your values.
# OpenAPI key required only if you run/debug the API.
#
# These are the single source of truth: the compose file interpolates the very
# same names (OpenAI__*, RAG__*, ...) that the .NET debug launch reads via
# envFile, so there is only ONE name per setting — no duplicated prefixes.

# --- OpenAI ---
OpenAI__ApiKey=
OpenAI__EmbeddingModel=text-embedding-3-small
OpenAI__ChatModel=gpt-4o-mini

# --- RAG defaults ---
RAG__TopK=5
RAG__MinSimilarity=0.7

# --- RAG observability report ---
RAG__Report__OutputDirectory=./reports

# --- PostgreSQL ---
POSTGRES_USER=prrag
POSTGRES_PASSWORD=prrag
POSTGRES_DB=prrag
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
