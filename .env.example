# Copy this file to .env and fill in your values.
# OPENAI_API_KEY is required to run the API.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- RAG defaults ---
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.7

# --- PostgreSQL ---
POSTGRES_USER=prrag
POSTGRES_PASSWORD=prrag
POSTGRES_DB=prrag
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
