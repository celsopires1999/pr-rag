{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build ${workspaceFolder}/backend/PrRag.sln -c Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "dotnet watch --project ${workspaceFolder}/backend/src/PrRag.Api/PrRag.Api.csproj",
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet test ${workspaceFolder}/backend/tests/PrRag.Tests/PrRag.Tests.csproj -c Debug",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
