{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PreRag.Api (DevContainer)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/PrRag.Api/bin/Debug/net10.0/PrRag.Api.dll",
      "cwd": "${workspaceFolder}/src/PrRag.Api",
      "args": [],
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:8080",
        "ConnectionStrings__Default": "Host=db;Port=5432;Database=prrag;Username=prrag;Password=prrag"
      },
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
