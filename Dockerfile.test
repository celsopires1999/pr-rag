# Build/test image for the integration tests.
#
# The image compiles the test project during build (so compile errors surface
# at build time) but the tests themselves run at CONTAINER RUNTIME via the
# entrypoint. Running them at runtime (instead of a build-time `RUN dotnet
# test`) lets the container wait for the `db` service through `depends_on`,
# since the database does not exist while the image is being built.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY PrRag.sln ./
COPY src/ src/
COPY tests/ tests/
COPY tools/ tools/

WORKDIR /src/tests/PrRag.Tests
RUN dotnet build --configuration Release --no-restore

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS runtime
WORKDIR /src

COPY PrRag.sln ./
COPY src/ src/
COPY tests/ tests/
COPY tools/ tools/

# Run as a non-root user (the .NET SDK image's built-in `app` user, UID
# $APP_UID). The test runner needs a writable working tree so that it can write
# build/test artifacts under /src.
RUN chown -R app:app /src

# Run the tests when the container starts (db is available via depends_on).
USER app
ENTRYPOINT ["dotnet", "test", "tests/PrRag.Tests/PrRag.Tests.csproj", "--configuration", "Release"]
